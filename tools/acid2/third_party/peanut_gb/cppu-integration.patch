@@ -3401,6 +3464,15 @@
 			}
 		}
 
+#if PEANUT_GB_EXTERNAL_PPU
+		/* cppu: The external PPU does all LCD timing, raises its
+		 * interrupts in IF and sets gb_frame. */
+		gb_ext_ppu_tick(gb, inst_cycles);
+
+		/* If halted forever, then return on a new frame. */
+		if(gb->gb_frame && gb->gb_halt && !gb->hram_io[IO_IE])
+			break;
+#else
 		/* If LCD is off, don't update LCD state or increase the LCD
 		 * ticks. Instead, keep track of the amount of time that is
